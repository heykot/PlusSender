# Токен Telegram-бота від @BotFather
BOT_TOKEN=

# API-ключ https://api.ukrainealarm.com/
ALARM_API_KEY=
# ID регіону (31 = Київ) і інтервал опитування, с (мінімум 5)
ALARM_REGION_ID=31
ALARM_POLL_INTERVAL=10

# Спільні ключі застосунку з my.telegram.org — тоді користувачам не треба вводити свої
TG_API_ID=
TG_API_HASH=

# Проксі до Telegram (необовʼязково): socks5://user:pass@host:port або http://…
TELEGRAM_PROXY=

# ── Monobank (необовʼязково) ──
# Personal token з https://api.monobank.ua
MONO_TOKEN=
# ID банки (jars[].id з /personal/client-info) і sendId без префіксу "jar/" для посилання
MONO_JAR_ID=
MONO_JAR_SEND_ID=
MONO_WEBHOOK_PORT=8080
# Базовий публічний HTTPS-URL, секрет додається автоматично: …/mono-webhook/<secret>
MONO_WEBHOOK_URL=
# Обовʼязковий, якщо задано MONO_TOKEN: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MONO_WEBHOOK_SECRET=
